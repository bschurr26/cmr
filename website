// ═══ SCORING ENGINE ═══
function sc(txt){
const T=N(txt),hits={};
for(const[tag,arr]of Object.entries(MOT))if(arr.some(x=>T.includes(N(x))))hits[tag]=1;
const res=[];
for(const[k,d]of Object.entries(DX)){
let s=0;d.tg.forEach(t=>{if(hits[t])s+=2});
const B=(rx,v)=>{if(rx.test(T))s+=v};
B(/cmh|hcm|sam|obstruct/,k==='HCM'?1.5:0);
B(/amyloid|amylose|attr|restrict|discordance/,k==='Amyloid'?1.5:0);
B(/fabry/,k==='Fabry'?2.5:0);
B(/acm|arvc|davd|dysplasi/,k==='ACM'?2.5:0);
B(/cia|asd|papvr|sinus venosus/,k==='ASD'?2.5:0);
B(/fallot|tetralogie|tetralogy|ip resid/,k==='TOF'?3:0);
B(/coarctation|coarct/,k==='Coarctation'?3:0);
B(/iao|insuffisance aort|aortic regurg/,k==='AR'?2.5:0);
B(/(im |insuffisance mitr|mitral regurg|prolapsus)/,k==='MR'?2.5:0);
B(/(it |insuffisance tricusp|teer)/,k==='TR'?2.5:0);
B(/(mass|masse|tumor|tumeur|thrombus|myxom)/,k==='Mass'?2:0);
B(/myocardit|lake louise/,k==='Myocarditis'?1.5:0);
B(/infarct|viabilit|stemi|nstemi/,k==='Infarct'?1.5:0);
B(/minoca/,k==='MINOCA'?3:0);B(/inoca|microvasc/,k==='INOCA'?3:0);
B(/takotsubo|tako|ballonis/,k==='Takotsubo'?3:0);
B(/(tv |esv|extrasystol|mort subite|sudden|syncope suspecte)/,k==='VT_SCD'?2:0);
B(/cardiomyopathie rythmique|tachycardie.*induit/,k==='RhythmicCMP'?3:0);
B(/(pre.ablation|ablation fa|ablation tv|veines pulmonaires)/,k==='PreAblation'?2:0);
B(/(stress|perfusion de stress|stenose intermediaire)/,k==='StressCMR'?2:0);
B(/sarcoid|granulom|bav inexpliqué/,k==='Sarcoid'?2:0);
B(/anthracycl|checkpoint|cardiotox|trastuzumab|immunother/,k==='CardioOnco'?2.5:0);
B(/pericard|constrict|tampon/,k==='Pericarditis'?1.5:0);
B(/sportif|athlete|marathon|endurance|zone grise/,k==='Athlete'?2:0);
B(/(cmd|dcm|insuffisance cardiaque|fevg basse)/,k==='DCM'?1.5:0);
B(/non.compaction|lvnc|trabecul/,k==='LVNC'?2:0);
B(/surcharge.*fer|hemochrom|t2\*/,k==='Iron'?2:0);
if(s>0.9)res.push({k,s});}
res.sort((a,b)=>b.s-a.s);return res.slice(0,8);
}

