$('cBtn').addEventListener('click',()=>{$('ctx').value='';$('wt').value='';$('egfr').value='';$('hct').value='';Object.keys(tgl).forEach(k=>tgl[k]=0);document.querySelectorAll('.tg').forEach(el=>el.classList.remove('on'));renderStr();renderRes();});
['wt','egfr','hct','ctx'].forEach(id=>$(id).addEventListener('input',()=>{renderStr();renderRes();}));
