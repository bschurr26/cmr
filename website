pr:[
{cat:"CINE",d:"Épaisseur MAXIMALE en TÉLÉDIASTOLE segment par segment base→apex. HVG asymétrique septale (80%), apicale (Yamaguchi = 'as de pique' en 4C), ou concentrique. SAM, contact mitro-septal, jet d'obstruction LVOT. IM postérieure associée. Rechercher anévrisme apical (2–5%) et cryptes myocardiques (phénotype pré-hypertrophique)."},
{cat:"T1",d:"T1↑ segments hypertrophiés = fibrose interstitielle. Si T1 BAS → évoquer Fabry (diagnostic différentiel majeur)."},
{cat:"T2",d:"Œdème focal = inflammation active ou post-alcoolisation/myectomie récente. Normal si CMH stable."},
{cat:"LGE",d:"Fibrose PATCHY segments hypertrophiés + points d'insertion VD. Quantifier % masse VG : ≥15% = haut risque arythmique (modificateur ESC 2023 IIb → DAI). Rechercher anévrisme apical entouré de LGE transmural."},
{cat:"ECV",d:"ECV↑ = fibrose diffuse interstitielle (complète le LGE qui ne voit que la focale)."}
],pt:["HVG asymétrique septale 80%, apicale 15%, concentrique 5%.","LGE ≥15% masse VG = haut risque arythmique indépendant du HCM Risk-SCD (ESC 2023).","Anévrisme apical (2–5%) = risque arythmique fort, souvent manqué en écho.","Burned-out = dilatation + FEVG <50% = très haut risque.","HCM Risk-SCD : âge, épaisseur max, Ø OG, gradient max, TVNS, réponse TA effort, ATCD familiaux. ≥6% DAI (IIa), 4–6% zone grise (IIb)."],
traps:["Épaisseur mesurée en systole = surestimation (toujours TÉLÉDIASTOLE).","LGE points d'insertion VD = quasi-physiologique chez sportif d'endurance.","CMH apicale sous-diagnostiquée en écho → IRM = examen de référence.","T1 natif BAS dans HVG = Fabry, pas CMH."]},

Amyloid:{tg:["hvg","amyloid"],n:"Amylose cardiaque",w:"HVG inexpliquée, discordance voltage-masse ECG, ICFEp avec épaississement.",
pr:[
{cat:"CINE",d:"Hypertrophie concentrique ± biV. OG/OD dilatées. Épanchement péricardique. Épaississement valvulaire mitral et tricuspide."},
{cat:"T1",d:"T1 natif ÉLEVÉ (>1100 ms à 1.5T MOLLI — valeur séquence/constructeur-dépendante). Parmi les plus hauts de toutes les cardiomyopathies."},
{cat:"T2",d:"Peut être↑ (œdème amyloïde). Moins discriminant que T1/ECV."},
{cat:"LGE",d:"UTILISER PSIR OBLIGATOIREMENT. Difficulté de nulling en magnitude = signe quasi-pathognomonique. Rehaussement sous-endocardique DIFFUS ou TRANSMURAL global. Pattern biV possible."},
{cat:"ECV",d:"ECV TRÈS ÉLEVÉ, souvent >40% (repère pratique, dépend site/séquence). Corrélé charge amyloïde. Paramètre CMR le plus puissant pour diagnostic et pronostic."}
],pt:["Difficulté de nulling en magnitude = quasi-pathognomonique → PSIR obligatoire.","T1 natif très↑ + ECV très↑ (>40%) = combinaison très évocatrice.","Épaississement valvulaire AV + hypertrophie concentrique + dilatation bi-atriale = triade.","Corrélation : scinti osseuse Perugini ≥2 sans gammapathie = ATTR. Immunofixation + chaînes légères libres = AL.","Dépistage actif : HVG inexpliquée sujet âgé, ICFEp, canal carpien bilatéral, RAo paradoxal bas débit/gradient."],
traps:["Ne pas essayer de nuller en magnitude quand c'est impossible → passer en PSIR.","ECV 30–40% = possible dans d'autres pathologies → croiser T1+LGE.","AL et ATTR : même aspect IRM → typage = hémato + scinti."]},

Fabry:{tg:["hvg","fabry"],n:"Maladie de Fabry",w:"HVG avec T1 natif BAS (quasi-pathognomonique avant fibrose). Homme jeune, atteinte systémique.",
pr:[
{cat:"CINE",d:"HVG concentrique ou segmentaire, souvent modérée. FEVG préservée."},
{cat:"T1",d:"T1 natif ABAISSÉ (<950 ms à 1.5T MOLLI) = accumulation sphingolipides (Gb3). Quasi-pathognomonique en contexte d'HVG. Peut pseudo-normaliser si fibrose extensive surajoutée."},
{cat:"T2",d:"T2↑ en zone inflammatoire active (co-localisé avec futur LGE). T2↑ = FENÊTRE THÉRAPEUTIQUE (enzyme substitutif avant fibrose irréversible)."},
{cat:"LGE",d:"LGE inféro-latéral basal MÉSOCARDIQUE en phase évoluée = fibrose de remplacement. Pattern relativement spécifique."},
{cat:"ECV",d:"Normal ou BAS en début (sphingolipides intracellulaires ≠ expansion extracellulaire). ↑ dans zones de fibrose (stade avancé)."}
],pt:["T1 natif BAS = clé diagnostique avant fibrose.","LGE inféro-latéral basal mésocardique = stade avancé, irréversible.","T2↑ zone inflammatoire = fenêtre thérapeutique → démarrer traitement enzymatique.","Corrélation : alpha-galactosidase A (basse ♂), lyso-Gb3 (élevé), génétique GLA."],
traps:["T1 peut pseudo-normaliser si fibrose surajoutée → ne pas exclure Fabry si T1 'normal' avec LGE inféro-latéral.","Chez la femme (hétérozygote) : expression variable, T1 peut être moins abaissé."]},

Myocarditis:{tg:["chest_injury"],n:"Myocardite aiguë / subaiguë",w:"Douleur thoracique + troponine + coronaires non obstructives.",
pr:[
{cat:"CINE",d:"Trouble cinétique FOCAL (≠ global comme Tako-Tsubo). Épanchement péricardique (myopéricardite). FEVG variable."},
{cat:"T2",d:"Œdème focal ou diffus = critère T2 Lake Louise 2018. T2 mapping quantitatif PLUS FIABLE que T2-STIR (moins sensible aux artefacts de mouvement). Attention : artefacts T2-STIR mimant hypersignal sous-épicardique → vérifier sur T2 mapping."},
{cat:"T1",d:"T1↑ = critère T1 Lake Louise 2018. Focal ou diffus."},
{cat:"ECV",d:"↑ en zone inflammatoire."},
{cat:"LGE",d:"Pattern NON ISCHÉMIQUE = SOUS-ÉPICARDIQUE ou MÉSOCARDIQUE, souvent INFÉRO-LATÉRAL. Clé : myocardite RESPECTE le sous-endocarde (≠ ischémique qui PART du sous-endocarde). Peut être multifocal."},
{cat:"CINE_SPECIAL",src:"Péricarde",d:"LGE péricardique + T2 péricardique si myopéricardite."}
],pt:["Lake Louise 2018 : ≥1 T2 + ≥1 T1 = myocardite active.","LGE sous-épicardique/mésocardique inféro-latéral = classique. RESPECTE le sous-endocarde.","TIMING : IRM dans les 2 semaines (sensibilité max). Œdème disparaît en 2–4 sem. LGE persiste (mois/années).","LGE résiduel = cicatrice = substrat arythmogène potentiel.","Myocardite = 1re cause de MINOCA (~60%)."],
traps:["Ne pas diagnostiquer sur T2 seul sans critère T1 (Lake Louise exige les deux).","Artefacts T2-STIR miment hypersignal sous-épicardique → vérifier T2 mapping.","LGE sous-endocardique territorial = infarctus, PAS myocardite."]},

Infarct:{tg:["chest_injury"],n:"Infarctus / viabilité",w:"SCA, viabilité pré-revascularisation, cardiopathie ischémique chronique.",
pr:[
{cat:"CINE",d:"Troubles cinétiques SEGMENTAIRES dans un TERRITOIRE CORONAIRE (IVA→antéro-septal/apical ; Cx→latéral/postérieur ; CD→inférieur/VD). Amincissement <5.5 mm si chronique = non viable. Anévrisme VG. Thrombus apical (masse sessile adhérente à paroi akinétique)."},
{cat:"T2",d:"Œdème = composante AIGUË. Délimite l'area at risk. Absent si chronique."},
{cat:"LGE",d:"SOUS-ENDOCARDIQUE → TRANSMURAL en territoire coronaire = PATHOGNOMONIQUE ischémique. L'infarctus PART TOUJOURS DU SOUS-ENDOCARDE (wave front de Reimer). Transmuralité = viabilité : <50% viable, >50% non viable. Reporter segment par segment (AHA 17 segments)."},
{cat:"LGE_SPECIAL",src:"LGE précoce (EGE 1–3 min)",d:"MVO = zone NOIRE CENTRALE dans l'infarctus = mauvais pronostic (remodelage, IC)."},
{cat:"LGE_SPECIAL",src:"LGE long TI (~600 ms 1.5T / ~875 ms 3T)",d:"Détection THROMBUS VG apical. Thrombus = NOIR (avasculaire). TOUJOURS chercher dans IDM antérieur étendu avec FEVG basse."},
{cat:"STRESS_PERF",d:"Défaut induit dans un AUTRE territoire que la nécrose = ischémie résiduelle → revascularisation."},
{cat:"DOBU",d:"Dobutamine faible dose (5–10–15 µg/kg/min) : réserve contractile dans segment akinétique + LGE <50% = viable."}
],pt:["LGE sous-endocardique/transmural territorial = pathognomonique ischémique.","Transmuralité : 0%=récup très probable ; 1–25%=très probable ; 26–50%=possible ~50% ; 51–75%=peu probable ; >75%=irréversible.","Épaisseur <5.5 mm = amincissement cicatriciel = non viable.","MVO (zone noire dans LGE) = mauvais pronostic indépendant.","Thrombus : long TI noir, paroi akinétique. Systématique dans IDM antérieur + FEVG <40%."],
traps:["Micro-IDM sous-endocardique (MINOCA) = ischémique, pas myocardite.","Toujours vérifier correspondance territoriale coronaire du LGE.","Oublier thrombus = risque embolique manqué."]},

MINOCA:{tg:["chest_injury"],n:"MINOCA",w:"Troponine↑ + coronaires non obstructives (<50%). CMR = examen CLÉ étiologique.",
pr:[
{cat:"CINE",d:"Trouble cinétique focal (myocardite, micro-IDM) vs global apical (Tako-Tsubo) vs normal."},
{cat:"T2",d:"Focal = myocardite/micro-IDM. Diffus apical = Tako-Tsubo. Absent = chronique/CMR normale."},
{cat:"T1",d:"T1↑ zone pathologique."},
{cat:"LGE",d:"Sous-épicardique = MYOCARDITE (~60%). Sous-endocardique territorial = MICRO-IDM (~15%). Absent + œdème apical = TAKO-TSUBO (~15%). Absent + rien = CMR NORMALE (~15–20%)."}
],pt:["CMR identifie la cause ~75–80%. Examen de 1re intention post-coronarographie.","Étiologies : myocardite 60% > micro-IDM 15% > Tako-Tsubo 15% > CMR N 15%.","TIMING : <2 semaines post-épisode (sensibilité max pour œdème T2).","CMR N → évoquer spasme (test ACh), maladie microvasculaire, myocardite guérie."],
traps:["IRM trop tardive (>4 sem) → œdème disparu, sensibilité↓.","LGE sous-endocardique + coronaires N = quand même ischémique (spasme, embolie, dissection spontanée)."]},

INOCA:{tg:["chest_injury"],n:"INOCA / maladie microvasculaire",w:"Angor + ischémie + coronaires non obstructives.",
pr:[
{cat:"CINE",d:"Fonction VG souvent préservée."},
{cat:"STRESS_PERF",d:"Défaut sous-endocardique CONCENTRIQUE NON TERRITORIALISÉ = atteinte microvasculaire (≠ segmentaire épicardique). Souvent diffus sur les 3 coupes."},
{cat:"T1",d:"T1/ECV↑ = fibrose diffuse (conséquence chronique microvasculaire)."},
{cat:"LGE",d:"Souvent absent. Si présent : micro-IDM punctiformes sous-endocardiques."}
],pt:["Défaut concentrique sous-endocardique non territorialisé = microvasculaire.","MPRI global abaissé si quantification dispo.","Compléter par test vasoréactivité invasif (ACh) si spasme suspecté."],
traps:["Dark rim artifact ≠ défaut concentrique : DRA transitoire <4 battements."]},

Takotsubo:{tg:["chest_injury"],n:"Tako-Tsubo",w:"Ballonisation apicale transitoire post-stress. Coronaires normales.",
pr:[
{cat:"CINE",d:"Ballonisation APICALE classique (ou variante médiane/basale). Hyperkinésie basale compensatrice. FEVG 30–45%."},
{cat:"T2",d:"Œdème DIFFUS segments ballonisés."},
{cat:"T1",d:"T1↑ segments atteints (transitoire)."},
{cat:"LGE",d:"ABSENCE LGE = argument MAJEUR vs IDM et myocardite. Si LGE → remettre en question le diagnostic."}
],pt:["Triade : ballonisation + œdème T2 + ABSENCE LGE.","Récupération FEVG en 2–8 semaines.","Variantes : apicale 80%, médiane 15%, basale inversée, focale."],
traps:["Si LGE → penser myocardite ou infarctus."]},

DCM:{tg:["dcm"],n:"CMD / ICFEr",w:"Dilatation VG, baisse FEVG, étiologie (ischémique vs non ischémique).",
pr:[
{cat:"CINE",d:"Volumes VG/VD indexés (BSA), FEVG/FEVD. Cinétique : globalement hypokinétique (CMD) vs segmentaire territorial (ischémique). IM fonctionnelle (tenting, coaptation)."},
{cat:"T1",d:"T1/ECV↑ = fibrose diffuse. Pronostic indépendant. ECV > T1 natif pour prédire événements."},
{cat:"T2",d:"Œdème si composante inflammatoire active (myocardite chronique, sarcoïdose, cardiotoxicité)."},
{cat:"LGE",d:"MID-WALL SEPTAL = CMD non ischémique (35% des CMD). SOUS-ENDOCARDIQUE territorial = ischémique. LGE mid-wall = risque arythmique INDÉPENDANT de FEVG → discussion DAI même si FEVG >35%."},
{cat:"PC",src:"PC aortique (si IM significative)",d:"Débit Ao antérograde pour quantification volumétrique IM."}
],pt:["LGE mid-wall septal = CMD non ischémique. Pronostic arythmique indépendant.","LGE mid-wall → discuter DAI même FEVG >35% (ESC 2022).","Absence LGE = meilleur pronostic, chance de récupération.","LGE sous-endocardique territorial = étiologie ischémique."],
traps:["LGE sous-endocardique ≠ CMD idiopathique → c'est ischémique.","Chercher étiologie traitable : myocardite, sarcoïdose, fer, tachycardie-induite."]},

RhythmicCMP:{tg:["arrhythmia","dcm"],n:"Cardiomyopathie rythmique",w:"Dysfonction VG + tachycardie chronique (FA rapide, ESV >15%, TV incessante).",
pr:[
{cat:"CINE",d:"Dilatation VG, baisse FEVG GLOBALE (pas segmentaire)."},
{cat:"T1",d:"T1/ECV NORMAUX ou sub-normaux = argument FORT de réversibilité (≠ CMD vraie où ECV↑)."},
{cat:"T2",d:"Normal."},
{cat:"LGE",d:"ABSENT ou minime = bon pronostic. Si LGE mid-wall significatif → CMD vraie + arythmie secondaire."}
],pt:["T1/ECV normaux + absence LGE = fort argument réversibilité.","Si LGE mid-wall → CMD vraie (pronostic moins bon).","Contrôle IRM 3–6 mois post-contrôle rythme."],
traps:["Ne pas diagnostiquer CMD idiopathique avant contrôle rythme → scanner après."]},

VT_SCD:{tg:["arrhythmia"],n:"TV / ESV / mort subite / syncope",w:"Bilan étiologique arythmie ventriculaire, ESV fréquentes (>10–15%), mort subite récupérée.",
pr:[
{cat:"CINE",d:"Bilan morphologique biV complet. CMH? CMD? ACM? Anévrisme? Akinésie segmentaire? RVOT dédié : dilatation, dyskinésie focale (ACM)."},
{cat:"T1",d:"Bas=Fabry. ↑=amylose/myocardite/fibrose. Oriente l'étiologie."},
{cat:"T2",d:"Œdème = inflammation active (myocardite aiguë, sarcoïdose active)."},
{cat:"LGE",d:"PATTERN = CLÉ ÉTIOLOGIQUE : sous-endo=ischémique, mid-wall=CMD, sous-épi=myocardite, patchy multifocal=sarcoïdose, segments hypertrophiés=CMH, sous-épi inféro-lat basal=Fabry/ACM left-dominant. Couverture EXHAUSTIVE base→apex incluant VD."}
],pt:["LGE = substrat arythmogène → corrélation cartographie EP.","ESV infundibulaires + CMR N = idiopathique (bon pronostic, ablation si symptomatique).","ESV/TV + LGE = substrat organique → risque TV soutenue → DAI.","Mort subite + CMR N = canalopathie → génétique (QT long, Brugada, CPVT).","Bilan systématique : CMH, ACM, CMD, sarcoïdose, myocardite, ischémique, LVNC, Fabry."],
traps:["Ne pas conclure 'cœur normal' sans LGE exhaustif base→apex.","ESV du VD ≠ toujours ACM (majorité idiopathiques si CMR N)."]},

ACM:{tg:["rv","arrhythmia"],n:"ACM / DAVD",w:"VD dilaté, TV retard gauche, ATCD familiaux mort subite.",
pr:[
{cat:"CINE",d:"Volumes VD indexés (RVEDVi, RVESVi), FEVD. Anomalies cinétiques RÉGIONALES VD : akinésie, dyskinésie, anévrismes. Triangle de dysplasie : RVOT, subtricuspidien, apex VD. Coupes axiales transverses complémentaires. Phénotype left-dominant : atteinte VG sous-épi latéral."},
{cat:"T1",d:"T1/ECV↑ zones atteintes VG (si phénotype gauche)."},
{cat:"LGE",d:"VD : paroi libre, subtricuspidien (coupes fines axiales). VG : sous-épi/mésocardique inféro-latéral si left-dominant."}
],pt:["Critères TFC 2010 : anomalies cinétiques VD régionales + RVEDVi ≥110 (♂)/≥100 (♀) ou FEVD <40% (majeur), 40–45% (mineur).","Triangle dysplasie : RVOT, subtricuspidien, apex VD.","Left-dominant : LGE sous-épi VG SANS anomalie VD."],
traps:["Faux positifs sportifs : VD dilaté adaptatif SANS dyskinésie focale ≠ ACM.","Graisse VD en fat-sat = PEU SPÉCIFIQUE → plus un critère fiable."]},

ASD:{tg:["rv","shunt"],n:"CIA / shunt / PAPVR",w:"Surcharge droite, VD dilaté, shunt.",
pr:[
{cat:"CINE",d:"Dilatation OD/VD. Paradoxe septal (flattening diastolique). Ciné SIA dédié : localisation defect (secundum, primum, sinus venosus, coronary sinus), taille, berges."},
{cat:"PC",src:"PC aorte + AP",d:"Qp/Qs = débit pulmonaire / débit aortique. >1.5 = shunt significatif → fermeture."},
{cat:"ANGIO",d:"Angio-RM 3D VP : rechercher PAPVR. Sinus venosus = TOUJOURS PAPVR associé."}
],pt:["Secundum 70%, sinus venosus 15–20%, primum (canal AV partiel).","Qp/Qs >1.5 = fermeture (percutanée si secundum, chirurgicale sinon).","Sinus venosus → PAPVR droite supérieure quasi-systématique."],
traps:["Qp/Qs en apnée faussé par Valsalva → préférer PC free-breathing pour shunts."]},

TOF:{tg:["rv","shunt"],n:"Fallot réparée",w:"IP résiduelle, dilatation VD, timing ré-intervention.",
pr:[
{cat:"CINE",d:"Volumes VD indexés, FEVD. Seuils ré-intervention : RVEDVi ≥160 mL/m² et/ou RVEF <47% (ESC 2020). Certaines équipes utilisent seuils plus bas (150/80)."},
{cat:"PC",src:"PC AP + Ao",d:"RF pulmonaire directe (>40% sévère). IAo résiduelle (fréquente, dilatation racine aortique)."},
{cat:"LGE",d:"Fibrose VD (patch RVOT, ventriculotomie) et VG = pronostic arythmique."},
{cat:"ANGIO",d:"Angio-RM AP si sténose de branche suspectée."}
],pt:["RVEDVi + FEVD + RF pulm = 3 paramètres clés de suivi.","ESC 2020 : RVEDVi ≥160, RVEF <47% → considérer remplacement VP.","IAo résiduelle souvent négligée → toujours mesurer."],
traps:["Seuils de ré-intervention varient entre guidelines (ESC vs AHA).","Ne pas oublier l'IAo."]},

Coarctation:{tg:["shunt","aorta"],n:"Coarctation aortique",w:"Gradient résiduel, collatérales, anévrisme post-réparation.",
pr:[
{cat:"CINE",d:"HVG (surcharge pression chronique). Fonction VG."},
{cat:"ANGIO",d:"Angio-RM 3D aorte : anatomie, anévrisme post-chirurgical, collatérales intercostales/mammaires."},
{cat:"PC",src:"PC site coarctation + Ao descendante",d:"Gradient. Flux diastolique PERSISTANT = signe le plus spécifique de coarctation significative. Rapport flux descendant/ascendant."}
],pt:["Angio-RM 3D = référence anatomique.","Flux diastolique persistant au PC > gradient de pic systolique.","Collatérales = sévérité/chronicité.","Surveiller anévrisme au site de réparation."],
traps:["Ne pas se fier au seul gradient systolique."]},

AR:{tg:["valve_ar"],n:"Insuffisance aortique",w:"Quantifier fuite, retentissement VG, morphologie valve/aorte.",
pr:[
{cat:"CINE",d:"Morphologie valve (bicuspidie? prolapsus cuspal?). Jet régurgitation. Dilatation VG excentrique si chronique. Cross-section valve pour bicuspidie (R-L >> R-N > L-N)."},
{cat:"PC",src:"PC aorte ascendante (jonction ST ou 1 cm au-dessus)",d:"Forward + backward flow. RF = backward/forward. VENC 150–250 cm/s. ⚠️ Le meilleur site est l'aorte tubulaire 1 cm au-dessus de la jonction ST (Hamilton-Craig SCMR 2011) — éviter les sinus (turbulence)."},
{cat:"ANGIO",d:"Angio-RM 3D aorte si dilatation : anneau, sinus, jonction ST, Ao ascendante tubulaire, crosse."}
],pt:["Seuils CMR IAo (pas de consensus unique) : Gelfand 2006 : légère ≤15%, modérée 16–25%, modérée-sévère 26–48%, sévère >48%. Myerson 2012 : RF >33% prédit progression vers chirurgie (PPV 85%). Les seuils CMR sont PLUS BAS que les seuils écho (ACC/AHA écho : RF >50% = sévère).","Flux holodiastolique inverse dans l'Ao descendante = sévère.","Bicuspidie → TOUJOURS chercher coarctation + dilatation Ao ascendante."],
traps:["Plan PC trop proche de la valve = turbulence/aliasing. Préférer 1 cm au-dessus de la jonction ST.","Ne pas utiliser les seuils écho (RF >50%) pour la CMR."]},

MR:{tg:["valve_mr"],n:"Insuffisance mitrale",w:"Quantifier, différencier primaire (organique) vs secondaire (fonctionnelle).",
pr:[
{cat:"CINE",d:"Mécanisme Carpentier (multi-axes scallops) : II (prolapsus/flail), IIIb (tenting), I (dilatation annulaire). Volumes VG, dilatation OG."},
{cat:"PC",src:"PC aorte ascendante",d:"Débit Ao antérograde (forward flow)."},
{cat:"CINE_SPECIAL",src:"Quantification volumétrique",d:"RV IM = SVVG (EDV−ESV ciné) − débit Ao antérograde (PC). RF = RV/SVVG. Méthode de RÉFÉRENCE en CMR."}
],pt:["Volumétrique = gold standard CMR. Pas de PC direct sur jet mitral.","IM primaire : RV >55 mL ou RF >40% associé à événements/chirurgie (Myerson Circ 2016).","IM secondaire : seuils ESC plus bas (EROA ≥20 mm², RV ≥30 mL écho). Pas de seuil CMR formel.","COAPT vs MITRA-FR : IM disproportionnée (SOR ≥30 + VTD <96 mL/m²) → MitraClip."],
traps:["Ne pas appliquer seuils IM primaire à fonctionnelle.","Vérifier cohérence volumes et exclure fuite concomitante."]},

TR:{tg:["valve_tr"],n:"Insuffisance tricuspide",w:"Quantifier fuite droite, bilan pré-TEER tricuspide.",
pr:[
{cat:"CINE",d:"Coaptation, tethering, annulus. Dilatation OD/VD. Volumes VD (EDV, ESV, SV)."},
{cat:"PC",src:"PC artère pulmonaire",d:"Débit pulmonaire antérograde."},
{cat:"CINE_SPECIAL",src:"Quantification volumétrique droite",d:"RV IT = SVVD − débit pulm antérograde. RF = RV IT / SVVD."}
],pt:["Volumétrique droite = même principe que IM à gauche.","Seuils CMR moins standardisés — intégrer clinique + écho.","Pré-TEER : annulus, tethering, anatomie sous-valvulaire."],
traps:["VD plus difficile à contourer → reproductibilité moindre."]},

MS:{tg:["valve_ms"],n:"Sténose mitrale",w:"Quantifier surface valvulaire, retentissement (OG, HTAP).",
pr:[
{cat:"CINE",d:"Morphologie valvulaire : épaississement, calcification, commissures, appareil sous-valvulaire. Planimétrie directe orifice mitral en mésodiastole (cross-section valve)."},
{cat:"CINE_SPECIAL",src:"Retentissement",d:"Dilatation OG. Thrombus auricule G si FA. HTAP (dilatation VD, IT)."}
],pt:["Étiologie : rhumatismale (90%), dégénérative, radique, congénitale.","Planimétrie directe = méthode CMR de choix.","Score de Wilkins (écho) = référence pour commissurotomie."],
traps:["L'écho reste supérieure à l'IRM pour les gradients transvalvulaires (Doppler continu)."]},

StressCMR:{tg:["stress_perf"],n:"IRM de stress (perfusion)",w:"Ischémie inductible, sténose intermédiaire.",
pr:[
{cat:"CINE",d:"Fonction base. ⚠️ VÉRIFIER VALVE AORTIQUE en ciné 3C/LVOT (RAo serré = CI relative au stress)."},
