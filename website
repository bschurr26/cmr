</div></section>
<section class="P" id="s-atlas"><div class="C"><div class="CH"><div class="ci">🫀</div><h2>Atlas diagnostics</h2></div><div class="sb"><span class="si">⌕</span><input id="aS" placeholder="Rechercher…"></div><div id="aB"></div></div></section>
</div></div>
