// ═══ SCORING ═══
const E=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
const $=id=>document.getElementById(id);
const N=s=>(s||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^\w\s/%.*-]/g,' ').replace(/\s+/g,' ').trim();
let tgl={stressWanted:0,pregnant:0,ciED:0,asthma:0,avblock:0,claustro:0,renal:0,ras:0};
const TGL=[{k:"stressWanted",l:"Stress demandé"},{k:"pregnant",l:"Grossesse"},{k:"ciED",l:"PM / DAI / implant"},{k:"asthma",l:"Asthme / bronchospasme"},{k:"avblock",l:"BAV II-III / dysf. sinusale"},{k:"claustro",l:"Claustrophobie sévère"},{k:"renal",l:"IR avancée (DFGe <30)"},{k:"ras",l:"RAo serré connu/suspecté"}];

function sc(txt){
const T=N(txt),hits={};
for(const[tag,arr]of Object.entries(MOT))if(arr.some(x=>T.includes(N(x))))hits[tag]=1;
const res=[];
for(const[k,d]of Object.entries(DX)){
let s=0;d.tg.forEach(t=>{if(hits[t])s+=2});
const B=(rx,v)=>{if(rx.test(T))s+=v};
B(/cmh|hcm|sam|obstruct/,k==='HCM'?1.5:0);B(/amyloid|amylose|attr|restrict|discordance/,k==='Amyloid'?1.5:0);B(/fabry/,k==='Fabry'?2.5:0);B(/acm|arvc|davd/,k==='ACM'?2.5:0);
B(/cia|asd|papvr|sinus venosus/,k==='ASD'?2.5:0);B(/fallot|tetralogie/,k==='TOF'?3:0);B(/coarctation|coarct/,k==='Coarctation'?3:0);
B(/iao|ia |insuffisance aort|aortic regurg|fuite aort/,k==='AR'?2.5:0);B(/(im |insuffisance mitr|mitral regurg|prolapsus|mitraclip)/,k==='MR'?2.5:0);
B(/(it |insuffisance tricusp|teer tricusp|triclip)/,k==='TR'?2.5:0);B(/(rm |sm |stenose mitrale|retrecissement mitral)/,k==='MS'?2.5:0);
B(/(rac|rao|ra |sao|stenose aort|retrecissement aort|tavi|tavr|pre.tavi)/,k==='PreTAVI'?2.5:0);
B(/(mass|masse|tumor|tumeur|thrombus|myxom)/,k==='Mass'?2:0);B(/myocardit|lake louise/,k==='Myocarditis'?1.5:0);
B(/infarct|viabilit|stemi|nstemi|idm/,k==='Infarct'?1.5:0);B(/minoca/,k==='MINOCA'?3:0);B(/inoca|microvasc/,k==='INOCA'?3:0);
B(/takotsubo|tako/,k==='Takotsubo'?3:0);B(/(tv |esv|extrasystol|mort subite|sudden|syncope|palpitation)/,k==='VT_SCD'?2:0);
B(/cardiomyopathie rythmique|tachycardie.*induit/,k==='RhythmicCMP'?3:0);B(/(ablation|veines pulmonaires|post.ablation|pre.ablation)/,k==='PreAblation'?2:0);
B(/(stress|perfusion de stress|stenose intermediaire)/,k==='StressCMR'?2:0);B(/sarcoid|granulom|bav inexpliq/,k==='Sarcoid'?2:0);
B(/anthracycl|checkpoint|cardiotox|trastuzumab|immunother|doxorubicine/,k==='CardioOnco'?2.5:0);B(/pericard|constrict|tampon/,k==='Pericarditis'?1.5:0);
B(/sportif|athlete|marathon|endurance|zone grise/,k==='Athlete'?2:0);B(/(cmd|dcm|insuffisance cardiaque|fevg basse|icfer|hfref|oap|decompens)/,k==='DCM'?1.5:0);
B(/non.compaction|lvnc|trabecul/,k==='LVNC'?2:0);B(/surcharge.*fer|hemochrom|t2\*|thalass/,k==='Iron'?2:0);
B(/htap|hypertension pulm|coeur pulmonaire/,k==='HTAP'?2.5:0);B(/endocardite|vegetation|osler/,k==='Mass'?1:0); // endocardite → mass
if(s>0.9)res.push({k,s});}
res.sort((a,b)=>b.s-a.s);return res.slice(0,8);}

