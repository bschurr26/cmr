if(d.pt){inner+=`<h4>Patterns / Key points</h4><ul style="margin:0 0 0 14px;padding:0">${d.pt.map(p=>`<li class="sm" style="margin-bottom:3px">${E(p)}</li>`).join('')}</ul>`;}
if(d.traps&&d.traps.length){inner+=`<h4>⚠️ Pièges</h4><ul style="margin:0 0 0 14px;padding:0;color:var(--dg)">${d.traps.map(p=>`<li class="sm" style="margin-bottom:3px">${E(p)}</li>`).join('')}</ul>`;}
o+=`<div class="acc" onclick="this.classList.toggle('open')"><div class="ah"><span>${E(d.n)}</span><span class="aa">▼</span></div><div class="ab2">${inner}</div></div>`;
});
$('atlB').innerHTML=o||`<div class="sm">Aucun résultat.</div>`;
}

// ═══ CALCULATORS ═══
function calc(){
const cw=+$('cW').value,ch=+$('cH').value;
$('bsaR').innerHTML=cw&&ch?`<b>${(0.007184*Math.pow(cw,0.425)*Math.pow(ch,0.725)).toFixed(3)} m²</b> <span class="sm">(Du Bois)</span>`:`<span class="sm">Entrer poids et taille.</span>`;

const e1=+$('e1').value,e2=+$('e2').value,e3=+$('e3').value,e4=+$('e4').value,eH=+$('eH').value;
if(e1&&e2&&e3&&e4&&eH){
const r1m=1/e2-1/e1,r1b=1/e4-1/e3,ecv=(1-eH/100)*(r1m/r1b)*100;
let interp='';
if(ecv<25)interp='Normal bas';else if(ecv<=30)interp='Normal';else if(ecv<=35)interp='Discrètement augmenté';else if(ecv<=40)interp='Augmenté';else interp='Très augmenté (évoquer amylose si > 40%)';
$('ecvR').innerHTML=`<b>ECV = ${ecv.toFixed(1)}%</b><br><span class="sm">${interp}. Les normes dépendent du champ et de la séquence — vérifier les références locales.</span>`;
}else $('ecvR').innerHTML=`<span class="sm">Remplir T1 pré/post myocarde + sang + Ht.</span>`;

const qp=+$('qp').value,qs=+$('qs').value;
if(qp&&qs){const r=qp/qs;let interp=r>1.5?'Shunt SIGNIFICATIF (> 1.5) → indication de fermeture':r>1.0?'Shunt minime':'Normal (≈ 1.0)';
$('qpR').innerHTML=`<b>Qp/Qs = ${r.toFixed(2)}</b><br><span class="sm">${interp}</span>`;}
else $('qpR').innerHTML=`<span class="sm">Entrer les débits pulmonaire et aortique (mL par cycle cardiaque).</span>`;

const ff=+$('ff').value,bf=+$('bf').value;
if(ff&&bf){const rf=bf/ff*100;let interp='';
if(rf<20)interp='Légère';else if(rf<33)interp='Modérée';else if(rf<48)interp='Significative (> 33%)';else interp='Sévère (> 48%)';
$('rfR').innerHTML=`<b>RF = ${rf.toFixed(1)}%</b> · RV = ${bf.toFixed(0)} mL<br><span class="sm">${interp}. Les seuils dépendent de la valve — consulter le tableau dédié.</span>`;}
else $('rfR').innerHTML=`<span class="sm">Entrer forward flow et backward flow en mL.</span>`;

const dw=+$('dW').value;
if(dw){const doses=[5,10,15,20,30,40].map(d=>({dose:d,ugmin:d*dw,mgh:d*dw/1000*60}));
$('dobR').innerHTML=`<div class="tw"><table><thead><tr><th>Palier</th><th>µg/kg/min</th><th>µg/min</th><th>mg/h</th><th>Usage</th></tr></thead><tbody>${doses.map(d=>`<tr><td>${d.dose}</td><td>${d.dose}</td><td>${d.ugmin.toFixed(0)}</td><td>${d.mgh.toFixed(1)}</td><td>${d.dose<=15?'Viabilité (réserve contractile)':'Stress inotrope (ischémie wall motion)'}</td></tr>`).join('')}</tbody></table></div><div class="xs" style="margin-top:6px">Paliers de 3 min. Atropine 0,25–2 mg si FC insuffisante. Stop si ischémie, TV, HTA > 240/120, chute PA > 40 mmHg.</div>`;}
else $('dobR').innerHTML=`<span class="sm">Entrer le poids.</span>`;

const gw=+$('gW').value,ge=+$('gE').value;
if(gw){const mmol=.1*gw;
$('gadR').innerHTML=`<b>0.1 mmol/kg → ${mmol.toFixed(1)} mmol</b><br><div class="sm">Concentration 0.5 mmol/mL : <b>${(mmol/.5).toFixed(1)} mL</b> · 1.0 mmol/mL : <b>${(mmol/1).toFixed(1)} mL</b></div><div class="sm">Stress fractionné : 2 × 0.05 mmol/kg = 2 × ${(mmol/2).toFixed(1)} mmol (bolus stress puis bolus repos, dose totale = 0.1 mmol/kg)</div>${ge&&ge<30?'<div class="warn-box" style="margin-top:6px">⚠️ DFGe < 30 : macrocyclique exclusivement, dose minimale diagnostique.</div>':''}`;}
else $('gadR').innerHTML=`<span class="sm">Entrer le poids.</span>`;
}

