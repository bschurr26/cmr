function mergeProtocol(hypos){
const catOrder=["CINE","CINE_SPECIAL","ANGIO","T1","T2","ECV","STRESS_PERF","DOBU","LGE","LGE_SPECIAL","PC"];
const catNames={CINE:"Cinés SSFP — protocole complet (stack SA base→apex + 2C/3C/4C + coupes dédiées)",CINE_SPECIAL:"Séquences ciné additionnelles",ANGIO:"Angio-RM 3D",T1:"T1 mapping natif (SA mid ± base/apex) — AVANT gadolinium",T2:"T2 mapping ± T2-STIR (SA mid ± base/apex)",ECV:"ECV (T1 pré + post-GBCA + Ht)",STRESS_PERF:"Perfusion first-pass (stress ± repos)",DOBU:"Dobutamine",LGE:"LGE PSIR (SA + LA, 8–15 min post-GBCA)",LGE_SPECIAL:"LGE séquences additionnelles",PC:"Contraste de phase (PC)"};
const merged={};
hypos.forEach(h=>{const d=DX[h.k];if(!d.pr)return;d.pr.forEach(p=>{
const cat=p.cat;if(!merged[cat])merged[cat]={items:[],sources:[]};
merged[cat].items.push({d:p.d,src:p.src||null,from:d.n});
merged[cat].sources.push(d.n);
});});
const result=[];let step=1;
catOrder.forEach(cat=>{if(!merged[cat])return;
const items=merged[cat].items;
const name=catNames[cat]||cat;
// Merge descriptions, avoiding exact duplicates
const seen=new Set();const descs=[];
items.forEach(it=>{const key=it.d.substring(0,40);if(!seen.has(key)){seen.add(key);descs.push(it);}});
result.push({step:step++,name,descs});
});
return result;
}

