$('gR').innerHTML=gw?`<b>0.1 mmol/kg → ${(.1*gw).toFixed(1)} mmol</b><br><span class="sm">0.5 mmol/mL : ${(.1*gw/.5).toFixed(1)} mL · 1.0 : ${(.1*gw).toFixed(1)} mL</span><br><span class="sm">Stress fractionné : 2 × ${(.05*gw).toFixed(1)} mmol</span>${ge&&ge<30?'<br><span class="sm" style="color:var(--dg)">⚠️ DFGe<30 : macrocyclique, dose min.</span>':''}`:`<span class="sm">Poids.</span>`;}

