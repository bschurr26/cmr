function renderRes(){
const txt=$('ctx').value||'',hy=sc(txt),ks=hy.map(h=>h.k);
let ap={l:'ok',m:'Indication cohérente pour CMR.'};
if(!ks.length)ap={l:'wn',m:'Compléter le contexte clinique pour générer des hypothèses.'};
let o=`<div class="badge ${ap.l==='ok'?'bok':'bwn'}">${ap.l==='ok'?'✓ Pertinent':'? Compléter le contexte'}</div><div class="sm" style="margin:6px 0 12px">${E(ap.m)}</div>`;

// Hypotheses
o+=`<h3>Hypothèses diagnostiques</h3>`;
if(!hy.length)o+=`<div class="sm">Entrer un contexte clinique plus précis.</div>`;
else{
o+=`<div class="chips" style="margin-bottom:8px">${hy.map(x=>`<div class="chip">${E(DX[x.k].n)}</div>`).join('')}</div>`;
hy.forEach(x=>{o+=`<div class="it"><b>${E(DX[x.k].n)}</b><div class="su">${E(DX[x.k].w)}</div></div>`;});
}

// UNIFIED PROTOCOL — deduplicated by first 30 chars of sequence name
if(hy.length){
const ord=["Ciné","Angio","T1","T2","ECV","Perfusion","Dobutamine","LGE","EGE","PC"];
const all=[];const seen=new Set();
hy.forEach(x=>{const d=DX[x.k];if(!d.pr)return;d.pr.forEach(p=>{
// Dedup key: normalize and take first significant words
const dk=N(p.s).replace(/[^a-z0-9 ]/g,'').split(' ').slice(0,4).join(' ');
if(!seen.has(dk)){seen.add(dk);all.push({...p,from:d.n});}
});});
all.sort((a,b)=>{const ia=ord.findIndex(x=>N(a.s).includes(N(x)));const ib=ord.findIndex(x=>N(b.s).includes(N(x)));return(ia<0?99:ia)-(ib<0?99:ib);});
o+=`<div class="sep"></div><h3>Protocole unifié — ${all.length} séquences</h3><div class="up">`;
let n=1;all.forEach(p=>{o+=`<div class="us"><div class="un">${n++}</div><div class="ub"><b>${E(p.s)}</b><div class="sd">${E(p.d)}</div><div class="xs" style="margin-top:2px">↳ ${E(p.from)}</div></div></div>`;});
o+=`</div>`;

// Patterns
o+=`<div class="sep"></div><h3>Patterns / Key points</h3>`;
hy.forEach(x=>{const d=DX[x.k];if(!d.pt)return;
o+=`<div class="it"><b>${E(d.n)}</b><ul style="margin:4px 0 0 14px;padding:0">${d.pt.map(p=>`<li class="sm" style="margin-bottom:3px">${E(p)}</li>`).join('')}</ul></div>`;});

// Traps/errors
const hasTraps=hy.some(x=>DX[x.k].traps&&DX[x.k].traps.length);
if(hasTraps){
o+=`<div class="sep"></div><h3>⚠️ Pièges / erreurs à éviter</h3>`;
hy.forEach(x=>{const d=DX[x.k];if(!d.traps||!d.traps.length)return;
o+=`<div class="warn-box" style="margin-bottom:7px"><b>${E(d.n)}</b><ul style="margin:4px 0 0 14px;padding:0">${d.traps.map(p=>`<li style="margin-bottom:3px">${E(p)}</li>`).join('')}</ul></div>`;});
}
}

// Gado
const w=+$('wt').value,e=+$('egfr').value;
if(w){
const mmol=.1*w;
o+=`<div class="sep"></div><h3>Gadolinium</h3><div class="tip-box">0.1 mmol/kg → <b>${mmol.toFixed(1)} mmol</b>. `;
o+=`Concentration 0.5 mmol/mL : ${(mmol/.5).toFixed(1)} mL. Concentration 1.0 mmol/mL : ${(mmol/1).toFixed(1)} mL. `;
o+=`Stress fractionné : 2 × 0.05 mmol/kg = 2 × ${(mmol/2).toFixed(1)} mmol.`;
if(e&&e<30)o+=`<br>⚠️ DFGe < 30 : privilégier macrocyclique, dose minimale diagnostique, accord du néphrologue.`;
o+=`</div>`;
}

// ECV hint
const ht=+$('hct').value;
if(ht)o+=`<div class="tip-box" style="margin-top:7px">ECV : utiliser Ht fractionnaire = ${(ht/100).toFixed(2)} dans la formule (1 − Ht) × (ΔR1 myo / ΔR1 sang).</div>`;

// Alerts
const al=[];
if(tgl.pregnant)al.push('⚠️ Grossesse : revoir indication. GBCA à éviter sauf si indispensable. Pas de CI formelle à l\'IRM.');
if(tgl.ciED)al.push('⚠️ CIED : vérifier compatibilité MR conditionnelle. Mode IRM. Monitoring EP. Wideband LGE si disponible pour réduire les artefacts.');
if(tgl.asthma)al.push('⚠️ Asthme : adénosine et dipyridamole = CI ABSOLUE. Regadenoson = CI relative (mieux toléré mais prudence). Dobutamine = alternative.');
if(tgl.avblock)al.push('⚠️ BAV II-III / dysfonction sinusale : tous les vasodilatateurs CI ABSOLUE sans pacemaker.');
if(tgl.claustro)al.push('⚠️ Claustrophobie : prémédication anxiolytique (hydroxyzine ou lorazépam). Accompagnement, musique, lunettes VR. Sédation consciente si échec.');
if(tgl.renal)al.push('⚠️ IR avancée (DFGe < 30) : utiliser agent macrocyclique exclusivement. Dose minimale. Pas de double dose. Le risque de NSF avec les macrocycliques modernes est extrêmement faible.');
if(tgl.ras)al.push('⚠️ RAo serré connu : CI RELATIVE à tous les agents de stress (vasodilatateurs ET dobutamine). Données récentes (Heidelberg 2023) montrent une sécurité acceptable sous surveillance renforcée, mais à discuter au cas par cas.');
if(tgl.asthma&&tgl.avblock)al.push('🚨 ASTHME + BAV = TOUS les vasodilatateurs sont CI absolue. Dobutamine = seule option (vérifier ses CI propres : HTA sévère, CMH obstructive, arythmie).');

if(al.length)o+=`<div class="sep"></div><h3>Alertes sécurité</h3>${al.map(a=>`<div class="it sm">${a}</div>`).join('')}`;

// Cross-links
if(ks.includes('Mass'))o+=`<div class="sep"></div><button class="lk" onclick="goTab('masses')">→ Voir onglet Masses (arbre décisionnel + tableau comparatif)</button>`;
if(ks.includes('StressCMR')||tgl.stressWanted)o+=`<button class="lk" onclick="goTab('stress')" style="margin-left:8px">→ Voir onglet Stress (doses, CI, antidotes)</button>`;

o+=`<div class="sep"></div><div class="xs">Aide experte de cadrage protocole. La validation finale du protocole, des contre-indications et des doses reste sous la responsabilité du centre et du médecin imageur.</div>`;
$('resB').innerHTML=o;
}

