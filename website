['cW','cH','e1','e2','e3','e4','eH','qp','qs','ff','bf','dW','gW','gE'].forEach(id=>$(id).addEventListener('input',calc));

initTgl();renderRes();renderTips();renderTbl();renderStress();renderMass();renderAtlas();calc();
</script></body></html>
