function initTgl(){let h='';TGL.forEach(t=>{h+=`<div class="tg" data-k="${t.k}"><span class="tl">${E(t.l)}</span><div class="sw"></div></div>`;});$('tgls').innerHTML=h;document.querySelectorAll('.tg').forEach(el=>{el.addEventListener('click',()=>{const k=el.dataset.k;tgl[k]=!tgl[k];el.classList.toggle('on',tgl[k]);});});}
document.querySelectorAll('.T').forEach(b=>b.addEventListener('click',()=>goTab(b.dataset.t)));
$('thB').addEventListener('click',()=>document.body.classList.toggle('dk'));
