function renderAtlas(f=''){
const F=N(f);let o='';
Object.entries(DX).forEach(([k,d])=>{
if(F&&!N(d.n+' '+d.w+' '+d.tg.join(' ')).includes(F))return;
let inner=`<div class="sm" style="margin-bottom:6px">${E(d.w)}</div>`;
